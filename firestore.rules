rules_version = '2';

// Each signed-in user can read and write ONLY their own data, stored under
// users/{their-uid}/... . Nobody can touch anyone else's files. This is all
// the security the free tier needs for a personal cloud IDE.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
